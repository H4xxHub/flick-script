local function CreateMaskedPanel()
    if MaskedPanel then
        MaskedPanel:Destroy()
        MaskedPanel = nil
    end
    
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "MaskedPanel"
    screenGui.Parent = LocalPlayer.PlayerGui
    screenGui.ResetOnSpawn = false
    screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screenGui.Enabled = MaskedPanelConfig.Enabled
    
    local panel = Instance.new("Frame")
    panel.Size = UDim2.new(0, MaskedPanelConfig.Size, 0, 280)
    panel.Position = MaskedPanelConfig.Position
    panel.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    panel.BackgroundTransparency = 0.15
    panel.BorderSizePixel = 1
    panel.BorderColor3 = Color3.fromRGB(80, 80, 100)
    panel.Parent = screenGui
    panel.Active = true
    panel.Selectable = true
    panel.ZIndex = 10
    
    local panelCorner = Instance.new("UICorner")
    panelCorner.CornerRadius = UDim.new(0, 8)
    panelCorner.Parent = panel
    
    panel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            isDraggingPanel = true
            dragStartPanel = input.Position
            startPosPanel = panel.Position
        end
    end)
    
    panel.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or 
           input.UserInputType == Enum.UserInputType.Touch then
            isDraggingPanel = false
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if isDraggingPanel and (input.UserInputType == Enum.UserInputType.MouseMovement or
                               input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStartPanel
            panel.Position = UDim2.new(
                startPosPanel.X.Scale,
                startPosPanel.X.Offset + delta.X,
                startPosPanel.Y.Scale,
                startPosPanel.Y.Offset + delta.Y
            )
            MaskedPanelConfig.Position = panel.Position
        end
    end)
    
    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 25)
    title.Position = UDim2.new(0, 0, 0, 5)
    title.BackgroundTransparency = 1
    title.Text = "MASKED"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextSize = 14
    title.Font = Enum.Font.GothamBold
    title.Parent = panel
    
    local scrollFrame = Instance.new("ScrollingFrame")
    scrollFrame.Size = UDim2.new(1, -10, 1, -35)
    scrollFrame.Position = UDim2.new(0, 5, 0, 30)
    scrollFrame.BackgroundTransparency = 1
    scrollFrame.BorderSizePixel = 0
    scrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    scrollFrame.ScrollBarThickness = 4
    scrollFrame.ScrollBarImageColor3 = Color3.fromRGB(100, 100, 150)
    scrollFrame.Parent = panel
    
    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 4)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = scrollFrame
    
    local Masks = {"Richter", "Tony", "Alex", "Brandon", "Cobra", "Richard", "Rabbit"}
    
    local function ActivateMaskedPower(maskName)
        print("[Masked] Activating:", maskName)
        local args = { maskName }
        
        local success, err = pcall(function()
            game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Killers"):WaitForChild("Masked"):WaitForChild("Activatepower"):FireServer(unpack(args))
        end)
        
        if success then
            print("[Masked] Activated:", maskName)
            WindUI:Notify({Title = maskName, Content = "Power activated!", Duration = 2})
        else
            print("[Masked] Failed:", err)
            WindUI:Notify({Title = "Failed", Content = tostring(err), Duration = 3})
        end
    end
    
    for _, maskName in pairs(Masks) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 30)
        btn.Position = UDim2.new(0, 5, 0, 0)
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
        btn.BackgroundTransparency = 0.5
        btn.Text = maskName
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextSize = 12
        btn.Font = Enum.Font.Gotham
        btn.Parent = scrollFrame
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn
        
        btn.MouseButton1Click:Connect(function()
            ActivateMaskedPower(maskName)
        end)
        
        btn.MouseEnter:Connect(function()
            btn.BackgroundColor3 = Color3.fromRGB(70, 70, 100)
            btn.BackgroundTransparency = 0.3
        end)
        
        btn.MouseLeave:Connect(function()
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
            btn.BackgroundTransparency = 0.5
        end)
    end
    
    local allBtn = Instance.new("TextButton")
    allBtn.Size = UDim2.new(1, -10, 0, 30)
    allBtn.Position = UDim2.new(0, 5, 0, 0)
    allBtn.BackgroundColor3 = Color3.fromRGB(80, 50, 50)
    allBtn.BackgroundTransparency = 0.5
    allBtn.Text = "ALL"
    allBtn.TextColor3 = Color3.fromRGB(255, 200, 100)
    allBtn.TextSize = 12
    allBtn.Font = Enum.Font.GothamBold
    allBtn.Parent = scrollFrame
    
    local allCorner = Instance.new("UICorner")
    allCorner.CornerRadius = UDim.new(0, 4)
    allCorner.Parent = allBtn
    
    allBtn.MouseButton1Click:Connect(function()
        for _, maskName in pairs(Masks) do
            ActivateMaskedPower(maskName)
            task.wait(0.1)
        end
        WindUI:Notify({Title = "All Masks", Content = "All powers activated!", Duration = 2})
    end)
    
    allBtn.MouseEnter:Connect(function()
        allBtn.BackgroundColor3 = Color3.fromRGB(120, 80, 80)
        allBtn.BackgroundTransparency = 0.3
    end)
    
    allBtn.MouseLeave:Connect(function()
        allBtn.BackgroundColor3 = Color3.fromRGB(80, 50, 50)
        allBtn.BackgroundTransparency = 0.5
    end)
    
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
    end)
    
    MaskedPanel = screenGui
    return screenGui
end

