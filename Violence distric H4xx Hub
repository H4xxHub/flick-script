-- ============ AUTO PARRY LOOP ============
local function AutoParryLoop()
    if not ParryConfig.Enabled then
        SetParryCircleColor(Color3.fromRGB(100, 100, 100))
        UpdateParryStatus("Disabled", Color3.fromRGB(150, 150, 150))
        UpdateKillerLabel(nil)
        return
    end
    
    UpdateParryMode(ParryConfig.ParryMode)
    
    local timeSinceGlobalCD = tick() - ParryState.LastSuccessfulParry
    local globalRemaining = math.max(0, ParryConfig.GlobalCooldown - timeSinceGlobalCD)
    UpdateGlobalCooldown(globalRemaining)
    
    if globalRemaining > 0 then
        SetParryCircleColor(Color3.fromRGB(255, 165, 0))
        UpdateParryStatus("Global CD", Color3.fromRGB(255, 165, 0))
        return
    end
    
    local timeSinceLastParry = tick() - ParryState.LastParryTime
    local cooldownRemaining = math.max(0, ParryState.ParryCooldown - timeSinceLastParry)
    UpdateParryCooldown(cooldownRemaining)
    
    local killer, distance = GetNearestKiller()
    
    local nearestDist = GetNearestKillerDistance()
    UpdateDangerBillboard(nearestDist)
    
    if not killer then
        SetParryCircleColor(Color3.fromRGB(255, 0, 0))
        UpdateParryStatus("No Killer", Color3.fromRGB(255, 100, 100))
        UpdateKillerLabel(nil)
        CurrentKiller = nil
        return
    end
    
    local killerData, animId = DetectKiller(killer)
    
    if killerData then
        CurrentKiller = killerData
        CurrentAnimId = animId
        UpdateKillerLabel(killerData)
    else
        UpdateKillerLabel(nil)
    end
    
    local triggerRange = 8
    if killerData and killerData.Settings then
        triggerRange = killerData.Settings.TriggerRange or 8
    end
    
    if distance > triggerRange then
        SetParryCircleColor(Color3.fromRGB(255, 0, 0))
        local statusText = string.format("Out of Range (%.1f/%d)", distance, triggerRange)
        UpdateParryStatus(statusText, Color3.fromRGB(255, 150, 0))
        return
    end
    
    if ParryConfig.WallCheck then
        local visible = IsKillerVisible(killer)
        if not visible then
            SetParryCircleColor(Color3.fromRGB(255, 0, 0))
            UpdateParryStatus("Wall Blocked", Color3.fromRGB(255, 150, 0))
            return
        end
    end
    
    local facingPlayer = IsKillerFacingPlayer(killer)
    if not facingPlayer then
        SetParryCircleColor(Color3.fromRGB(255, 200, 0))
        UpdateParryStatus("Not Facing", Color3.fromRGB(255, 200, 0))
        return
    end
    
    SetParryCircleColor(Color3.fromRGB(0, 255, 0))
    
    local isAttacking = IsKillerAttacking(killer)
    
    if isAttacking then
        SetParryCircleColor(Color3.fromRGB(255, 255, 0))
        
        if killerData then
            local statusText = killerData.Emoji .. " " .. killerData.Name
            if killerData.Settings.IsLunge then
                statusText = statusText .. " [Lunge]"
            else
                statusText = statusText .. " [Melee]"
            end
            UpdateParryStatus(statusText .. " Attacking!", Color3.fromRGB(255, 255, 0))
        else
            UpdateParryStatus("Attack Detected!", Color3.fromRGB(255, 255, 0))
        end
        
        if ParryState.IsParrying then
            return
        end
        
        if timeSinceLastParry < 1.0 then
            return
        end
        
        local success = TriggerParry()
        if success then
            SetParryCircleColor(Color3.fromRGB(0, 255, 255))
            
            if killerData then
                UpdateParryStatus("✅ " .. killerData.Emoji .. " " .. killerData.Name .. " Parried!", Color3.fromRGB(0, 255, 255))
            else
                UpdateParryStatus("PARRYING!", Color3.fromRGB(0, 255, 255))
            end
            
            ParryState.LastSuccessfulParry = tick()
            
            if ParryConfig.PlayAnimation then
                PlayParryAnimation()
            end
            
            local killerName = killerData and (killerData.Emoji .. " " .. killerData.DisplayName) or "Unknown Killer"
            WindUI:Notify({
                Title = "✅ Parry Berhasil!",
                Content = "vs " .. killerName .. " | Cooldown 60s",
                Duration = 3,
            })
        else
            UpdateParryStatus("Failed to Parry", Color3.fromRGB(255, 0, 0))
        end
    else
        if killerData then
            local statusText = killerData.Emoji .. " " .. killerData.Name
            if killerData.Settings.IsLunge then
                statusText = statusText .. " [Lunge]"
            else
                statusText = statusText .. " [Melee]"
            end
            UpdateParryStatus(string.format("%s | %.1f/%d studs", statusText, distance, triggerRange), Color3.fromRGB(0, 255, 0))
        else
            UpdateParryStatus(string.format("In Range (%.1f) - Ready", distance), Color3.fromRGB(0, 255, 0))
        end
    end
end

-- ============ AIMLOCK FUNCTIONS ============
local function IsKillerInFOV(killerChar)
    if not killerChar then return false end
    
    local root = killerChar:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
    if not onScreen then return false end
    
    local centerX = Camera.ViewportSize.X / 2
    local centerY = Camera.ViewportSize.Y / 2
    local distance = math.sqrt((screenPos.X - centerX)^2 + (screenPos.Y - centerY)^2)
    
    return distance <= AimlockConfig.FOVRadius
end

local function GetClosestKillerInFOV()
    local char = LocalPlayer.Character
    if not char then return nil end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    
    local closest = nil
    local closestDist = math.huge
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Team and player.Team.Name == "Killer" then
            local killerChar = player.Character
            if killerChar then
                local killerRoot = killerChar:FindFirstChild("HumanoidRootPart")
                if killerRoot then
                    if IsKillerInFOV(killerChar) then
                        local dist = (killerRoot.Position - root.Position).Magnitude
                        if dist < closestDist then
                            closestDist = dist
                            closest = killerChar
                        end
                    end
                end
            end
        end
    end
    
    return closest, closestDist
end

-- ============ AIMLOCK LOOP ============
local function AimlockLoop()
    if not AimlockConfig.Enabled then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    
    if AimlockConfig.ActivateOnAnimation then
        local animPlaying = IsAimAnimationPlaying()
        if not animPlaying then
            AimlockState.Target = nil
            return
        end
    end
    
    local target, dist = GetClosestKillerInFOV()
    
    if target then
        local targetRoot = target:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            local screenPos, onScreen = Camera:WorldToViewportPoint(targetRoot.Position)
            if onScreen then
                local centerX = Camera.ViewportSize.X / 2
                local centerY = Camera.ViewportSize.Y / 2
                
                local deltaX = screenPos.X - centerX
                local deltaY = screenPos.Y - centerY
                
                if AimlockConfig.Mode == "Instant" then
                    mousemoverel(deltaX, deltaY)
                else
                    local smoothX = deltaX * 0.3
                    local smoothY = deltaY * 0.3
                    mousemoverel(smoothX, smoothY)
                end
                
                AimlockState.Target = target
            end
        end
    else
        AimlockState.Target = nil
    end
end

-- ============ ESP FUNCTIONS ============
local function GetTeamColor(teamName)
    if teamName == "Killer" then
        return Color3.fromRGB(255, 0, 0)
    elseif teamName == "Survivors" then
        return Color3.fromRGB(0, 255, 0)
    elseif teamName == "Spectator" then
        return Color3.fromRGB(255, 255, 255)
    else
        return Color3.fromRGB(255, 255, 255)
    end
end

local function GetHealthColor(healthPercent)
    if healthPercent >= 80 then
        return Color3.fromRGB(0, 255, 0)
    elseif healthPercent >= 50 then
        return Color3.fromRGB(255, 255, 0)
    elseif healthPercent >= 20 then
        return Color3.fromRGB(255, 165, 0)
    else
        return Color3.fromRGB(128, 0, 255)
    end
end

local function CreateHighlight(character, color)
    if not character then return nil end
    
    local highlight = Instance.new("Highlight")
    highlight.FillColor = color
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.3
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
    
    return highlight
end

local function ClearESP()
    for _, obj in pairs(ESPObjects) do
        pcall(function()
            if obj then obj:Destroy() end
        end)
    end
    ESPObjects = {}
end

local function UpdateESP()
    if not ESPEnabled then
        ClearESP()
        return
    end
    
    ClearESP()
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local teamName = player.Team and player.Team.Name or "No Team"
                local color = GetTeamColor(teamName)
                
                if teamName == "Survivors" then
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        local healthPercent = (humanoid.Health / humanoid.MaxHealth) * 100
                        color = GetHealthColor(healthPercent)
                    end
                end
                
                local highlight = CreateHighlight(char, color)
                if highlight then
                    table.insert(ESPObjects, highlight)
                end
            end
        end
    end
end

local function SetupESPListeners()
    for _, conn in pairs(ESPConnections) do
        pcall(function() conn:Disconnect() end)
    end
    ESPConnections = {}
    
    local conn1 = Players.PlayerAdded:Connect(function()
        task.wait(0.5)
        UpdateESP()
    end)
    table.insert(ESPConnections, conn1)
    
    local conn2 = Players.PlayerRemoving:Connect(function()
        UpdateESP()
    end)
    table.insert(ESPConnections, conn2)
    
    local conn3 = Players.PlayerAdded:Connect(function(player)
        player:GetPropertyChangedSignal("Team"):Connect(function()
            UpdateESP()
        end)
    end)
    table.insert(ESPConnections, conn3)
    
    local conn4 = Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function()
            task.wait(0.5)
            UpdateESP()
        end)
    end)
    table.insert(ESPConnections, conn4)
    
    local conn5 = Players.PlayerAdded:Connect(function(player)
        player.CharacterAdded:Connect(function(char)
            task.wait(0.5)
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.HealthChanged:Connect(function()
                    UpdateESP()
                end)
            end
        end)
    end)
    table.insert(ESPConnections, conn5)
end

local function ESPLoop()
    if not ESPEnabled then return end
    
    ESPUpdateTimer = ESPUpdateTimer + RunService.Heartbeat:Wait()
    if ESPUpdateTimer >= ESPUpdateInterval then
        ESPUpdateTimer = 0
        pcall(UpdateESP)
    end
end

