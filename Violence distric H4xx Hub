-- ============ KILLER DETECTION FUNCTIONS ============
local function DetectKiller(killerChar)
    if not killerChar then return nil, nil end
    
    local humanoid = killerChar:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil, nil end
    
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return nil, nil end
    
    for _, track in pairs(animator:GetPlayingAnimationTracks()) do
        local animId = track.Animation.AnimationId
        if animId then
            local id = animId:match("%d+")
            if id then
                local killerData = KillerDatabase[id]
                if killerData then
                    return killerData, id
                end
            end
        end
    end
    
    return nil, nil
end

local function IsKillerAttacking(killerChar)
    if not killerChar then return false end
    
    local humanoid = killerChar:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return false end
    
    for _, track in pairs(animator:GetPlayingAnimationTracks()) do
        local animId = track.Animation.AnimationId
        if animId then
            local id = animId:match("%d+")
            if id then
                if KillerDatabase[id] then
                    return true
                end
            end
        end
    end
    
    return false
end

local function IsAimAnimationPlaying()
    local char = LocalPlayer.Character
    if not char then return false end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return false end
    
    for _, track in pairs(animator:GetPlayingAnimationTracks()) do
        local id = track.Animation.AnimationId
        if id then
            local animId = id:match("%d+")
            if animId then
                if animId == SilentAimConfig.AnimationId then
                    return true
                end
                for _, aimId in pairs(AimAnimations) do
                    if animId == aimId then
                        return true
                    end
                end
            end
        end
    end
    
    return false
end

local function IsKillerFacingPlayer(killerChar)
    if not killerChar then return false end
    
    local killerRoot = killerChar:FindFirstChild("HumanoidRootPart")
    local playerRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    
    if not killerRoot or not playerRoot then return false end
    
    local directionToPlayer = (playerRoot.Position - killerRoot.Position).Unit
    local killerLookVector = killerRoot.CFrame.LookVector
    local dotProduct = killerLookVector:Dot(directionToPlayer)
    
    return dotProduct > ParryConfig.CurrentFaceSensitivity
end

