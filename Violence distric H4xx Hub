local function UpdateESP()
    if ESPIsUpdating then return end
    
    ESPIsUpdating = true
    
    local success, err = pcall(function()
        ClearESP()
        
        local hasESP = ESPConfig.Player or ESPConfig.Pallet or ESPConfig.Hook or ESPConfig.Generator or ESPConfig.Window
        if not hasESP then
            ESPIsUpdating = false
            return
        end
        
        if ESPConfig.Player then
            for _, player in pairs(Players:GetPlayers()) do
                if player ~= LocalPlayer then
                    local char = player.Character
                    if char and char.Parent then
                        local color = GetPlayerColor(player)
                        local highlight = CreateOutline(char, color)
                        if highlight then table.insert(ESPObjects, highlight) end
                    end
                end
            end
        end
        
        local objects = FindMapObjects()
        
        if ESPConfig.Pallet then
            for _, pallet in pairs(objects.Pallets) do
                if pallet and pallet.Parent then
                    local highlight = CreateOutline(pallet, Color3.fromRGB(255, 200, 0))
                    if highlight then table.insert(ESPObjects, highlight) end
                end
            end
        end
        
        if ESPConfig.Hook then
            for _, hook in pairs(objects.Hooks) do
                if hook and hook.Parent then
                    local highlight = CreateOutline(hook, Color3.fromRGB(0, 255, 255))
                    if highlight then table.insert(ESPObjects, highlight) end
                end
            end
        end
        
        if ESPConfig.Generator then
            for _, generator in pairs(objects.Generators) do
                if generator and generator.Parent then
                    local highlight = CreateOutline(generator, Color3.fromRGB(160, 32, 240))
                    if highlight then table.insert(ESPObjects, highlight) end
                end
            end
        end
        
        if ESPConfig.Window then
            for _, window in pairs(objects.Windows) do
                if window and window.Parent then
                    local highlight = CreateOutline(window, Color3.fromRGB(255, 0, 255))
                    if highlight then table.insert(ESPObjects, highlight) end
                end
            end
        end
    end)
    
    ESPIsUpdating = false
    
    if not success then
        print("[ESP] ❌ Error:", err)
    end
