local function KillerAimbotLoop()
    if not AimbotConfig.Killer.Enabled then return end
    
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    local nearestTarget = nil
    local nearestDist = AimbotConfig.Killer.Range
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local team = player.Team and player.Team.Name or ""
            if team == "Survivors" then
                local pChar = player.Character
                if pChar then
                    local pRoot = pChar:FindFirstChild("HumanoidRootPart")
                    if pRoot then
                        local dist = (pRoot.Position - root.Position).Magnitude
                        if dist < nearestDist and dist > AimbotConfig.Killer.MinRange then
                            nearestDist = dist
                            nearestTarget = pChar
                        end
                    end
                end
            end
        end
    end
    
    AimbotState.Target = nearestTarget
    
    if nearestTarget then
        local targetRoot = nearestTarget:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            local targetPos = targetRoot.Position
            local direction = (targetPos - root.Position).Unit
            
            if AimbotConfig.Killer.Mode == "Smooth" then
                local currentLook = root.CFrame.LookVector
                local newLook = currentLook:Lerp(direction, 1 - AimbotConfig.Killer.Smoothness)
                root.CFrame = CFrame.new(root.Position, root.Position + newLook)
            else
                root.CFrame = CFrame.new(root.Position, targetPos)
            end
        end
    end
end

