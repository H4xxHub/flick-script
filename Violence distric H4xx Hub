-- CEK GENERATOR DI MAP
local function CheckGenerators()
    local map = workspace:FindFirstChild("Map")
    if not map then
        print("[Auto Gen] ❌ Map not found!")
        return false
    end
    
    local generatorsContainer = map:FindFirstChild("Generators") or map:FindFirstChild("Gens") or map:FindFirstChild("NewGenerators")
    if not generatorsContainer then
        print("[Auto Gen] ❌ Generators container not found!")
        return false
    end
    
    local totalGenerators = 0
    local totalPoints = 0
    
    for _, child in pairs(generatorsContainer:GetChildren()) do
        if child.Name == "Generator" and child:IsA("Model") then
            totalGenerators = totalGenerators + 1
            print("[Auto Gen] Found Generator:", child.Name)
            
            for i = 1, 4 do
                local point = child:FindFirstChild("GeneratorPoint" .. i)
                if point then
                    totalPoints = totalPoints + 1
                    print("[Auto Gen]   ✅ Point", i, ":", point.Name)
                else
                    print("[Auto Gen]   ❌ Point", i, ": Not found")
                end
            end
        end
    end
    
    print("[Auto Gen] Total Generators:", totalGenerators)
    print("[Auto Gen] Total Points (1-4):", totalPoints)
    
    return totalGenerators > 0 and totalPoints > 0
end

-- SETUP AUTO GEN
local function SetupAutoGen()
    local map = workspace:FindFirstChild("Map")
    if not map then return false end
    
    local generatorsContainer = map:FindFirstChild("Generators") or map:FindFirstChild("Gens") or map:FindFirstChild("NewGenerators")
    if not generatorsContainer then return false end
    
    AutoGenAllGenerators = {}
    for _, child in pairs(generatorsContainer:GetChildren()) do
        if child.Name == "Generator" and child:IsA("Model") then
            table.insert(AutoGenAllGenerators, child)
        end
    end
    
    AutoGenAllPoints = {}
    for _, gen in pairs(AutoGenAllGenerators) do
        for i = 1, 4 do
            local point = gen:FindFirstChild("GeneratorPoint" .. i)
            if point then
                table.insert(AutoGenAllPoints, {
                    Generator = gen,
                    Point = point
                })
            end
        end
    end
    
    print(string.format("[Auto Gen] Found %d generators, %d points (1-4)", #AutoGenAllGenerators, #AutoGenAllPoints))
    return #AutoGenAllGenerators > 0 and #AutoGenAllPoints > 0
end

-- CEK APAKAH PLAYER BERDIRI DI SALAH SATU GENERATORPOINT 1-4
local function CheckPlayerOnGeneratorPoint()
    local char = LocalPlayer.Character
    if not char then return false, nil, nil end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false, nil, nil end
    
    local playerPos = root.Position
    
    for _, data in pairs(AutoGenAllPoints) do
        local point = data.Point
        if point and point:IsA("BasePart") then
            local pointPos = point.Position
            local dist = (playerPos - pointPos).Magnitude
            if dist < 3 then
                return true, point, data.Generator
            end
        end
    end
    
    return false, nil, nil
end

-- CEK APAKAH PLAYER DIAM (SPEED 0)
local function IsPlayerIdle()
    local char = LocalPlayer.Character
    if not char then return false end
    
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    
    return hum.WalkSpeed == 0
end

-- CEK DURASI PLAYER DI POINT
local function GetPlayerOnPointDuration()
    local onPoint, point, gen = CheckPlayerOnGeneratorPoint()
    local idle = IsPlayerIdle()
    
    if not onPoint or not idle then
        return false, nil, nil, 0
    end
    
    if not PointStartTime then
        PointStartTime = tick()
    end
    
    local duration = tick() - PointStartTime
    
    if duration >= 1.5 then
        PointStartTime = tick()
        return true, point, gen, duration
    end
    
    return false, point, gen, duration
end

-- FIRE REPAIR
local function FireRepair(point, gen)
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if not remote then return end
    
    local genRemote = remote:FindFirstChild("Generator")
    if not genRemote then return end
    
    local repairRemote = genRemote:FindFirstChild("RepairEvent")
    local skillRemote = genRemote:FindFirstChild("SkillCheckResultEvent")
    
    if not repairRemote or not skillRemote then return end
    
    pcall(function()
        repairRemote:FireServer(point, true)
    end)
    
    task.wait(0.05)
    
    pcall(function()
        skillRemote:FireServer("success", 1, gen, point)
    end)
end

-- START AUTO GEN
local function StartAutoGen()
    if AutoGenIsSpamming then return end
    if isSpamming then return end
    
    AutoGenIsSpamming = true
    isSpamming = true
    AutoGenSpamCount = 0
    PointStartTime = nil
    
    if not SetupAutoGen() then
        print("[Auto Gen] ❌ Setup failed! No generators or points found.")
        AutoGenIsSpamming = false
        isSpamming = false
        return
    end
    
    print("[Auto Gen] Started! Waiting for player on point...")
    
    spamThread = task.spawn(function()
        local remote = ReplicatedStorage:FindFirstChild("Remotes")
        if not remote then
            print("[Auto Gen] ❌ Remotes not found!")
            AutoGenIsSpamming = false
            isSpamming = false
            return
        end
        
        local genRemote = remote:FindFirstChild("Generator")
        if not genRemote then
            print("[Auto Gen] ❌ Generator remote not found!")
            AutoGenIsSpamming = false
            isSpamming = false
            return
        end
        
        local repairRemote = genRemote:FindFirstChild("RepairEvent")
        local skillRemote = genRemote:FindFirstChild("SkillCheckResultEvent")
        
        if not repairRemote or not skillRemote then
            print("[Auto Gen] ❌ RepairEvent or SkillCheckResultEvent not found!")
            AutoGenIsSpamming = false
            isSpamming = false
            return
        end
        
        while isSpamming and AutoGenEnabled do
            local ready, point, gen, duration = GetPlayerOnPointDuration()
            
            if ready and point and gen then
                AutoGenSpamCount = AutoGenSpamCount + 1
                
                FireRepair(point, gen)
                
                if AutoGenSpamCount % 5 == 0 then
                    print(string.format("[Auto Gen] Spam #%d - Point: %s", AutoGenSpamCount, point.Name))
                end
                
                task.wait(0.05)
                
                -- CEK APAKAH PLAYER MASIH DI POINT
                local stillOnPoint, _, _ = CheckPlayerOnGeneratorPoint()
                if not stillOnPoint then
                    print("[Auto Gen] ❌ Player left point! Stopping...")
                    PointStartTime = nil
                    break
                end
            else
                if not CheckPlayerOnGeneratorPoint() then
                    PointStartTime = nil
                end
                task.wait(0.2)
            end
        end
        
        print("[Auto Gen] Stopped!")
        AutoGenIsSpamming = false
        isSpamming = false
        spamThread = nil
    end)
end

-- STOP AUTO GEN
local function StopAutoGen()
    AutoGenEnabled = false
    AutoGenIsSpamming = false
    isSpamming = false
    PointStartTime = nil
    
    if spamThread then
        task.cancel(spamThread)
        spamThread = nil
    end
    
    print("[Auto Gen] Stopped!")
end

