local oldIndex = nil
local VeilHookActive = false
local VeilHookInstalled = false
local original__index = nil

local function SetupVeilHook()
    if VeilHookActive then return end
    
    print("[Veil] 🔧 Setting up hook...")
    
    local mt = getrawmetatable(game)
    if not mt then
        print("[Veil] ❌ Cannot get metatable!")
        return
    end
    
    original__index = mt.__index
    
    oldIndex = hookmetamethod(game, "__index", function(self, key)
        if VeilConfig.Enabled and self:IsA("Camera") and key == "CFrame" then
            local callingScript = getcallingscript and getcallingscript()
            if callingScript and 
               (string.find(callingScript.Name, "Projectile") or 
                string.find(callingScript.Name, "Veil") or 
                string.find(callingScript.Name, "Animations")) then
                local predictedPos = VeilGetDynamicPrediction()
                if predictedPos then
                    local originalCFrame = original__index(self, key)
                    if originalCFrame then
                        return CFrame.new(originalCFrame.Position, predictedPos)
                    end
                end
            end
        end
        return original__index(self, key)
    end)
    
    VeilHookActive = true
    VeilHookInstalled = true
    print("[Veil] ✅ Hook installed!")
end

local function UnhookVeil()
    if not VeilHookActive then return end
    
    print("[Veil] 🔧 Unhooking...")
    
    pcall(function()
        local mt = getrawmetatable(game)
        if mt then
            if original__index then
                mt.__index = original__index
                print("[Veil] ✅ Hook restored to original!")
            else
                mt.__index = nil
                print("[Veil] ✅ Hook removed!")
            end
        end
    end)
    
    oldIndex = nil
    VeilHookActive = false
    VeilHookInstalled = false
    print("[Veil] ❌ Unhooked!")
end

-- ============================================
-- 🔍 VEIL SCAN SINGLE TARGET
-- ============================================
local function VeilScanSingleTarget()
    if not VeilConfig.Enabled then return nil, nil, math.huge end
    if not (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")) then 
        return nil, nil, math.huge
    end
    
    local myPos = LocalPlayer.Character.HumanoidRootPart.Position
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    local closestPlayerPart = nil
    local closestScreenPos = nil
    local shortestFovDistance = math.huge
    local finalDistance3D = math.huge
    local closestPlayerName = nil
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild(VeilConfig.TargetPart) then
            if player.Team and player.Team.Name == "Survivors" then
                local targetPart = player.Character[VeilConfig.TargetPart]
                if targetPart and targetPart:IsA("BasePart") then
                    local heightOffset = VeilState.CurrentHeightOffset
                    local headPos = targetPart.Position + Vector3.new(0, heightOffset, 0)
                    local screenPos, onScreen = Camera:WorldToViewportPoint(headPos)
                    
                    if onScreen then
                        local targetPos = Vector2.new(screenPos.X, screenPos.Y)
                        local fovDistance = (screenCenter - targetPos).Magnitude
                        
                        if fovDistance <= VeilConfig.FOVRadius then
                            local distance3D = (myPos - headPos).Magnitude
                            
                            if distance3D < VeilConfig.MaxDistance and fovDistance < shortestFovDistance then
                                shortestFovDistance = fovDistance
                                closestPlayerPart = targetPart
                                closestScreenPos = targetPos
                                finalDistance3D = distance3D
                                closestPlayerName = player.Name
                            end
                        end
                    end
                end
            end
        end
    end
    
    VeilState.TargetName = closestPlayerName
    return closestPlayerPart, closestScreenPos, finalDistance3D
end

-- ============================================
-- 🎯 VEIL AUTO PREDICT HEIGHT
-- ============================================
local function VeilGetAutoHeight(distance)
    if not VeilConfig.AutoPredictHeight then
        return VeilConfig.HeadOffset
    end
    
    if distance <= 100 then
        return 1.0
    elseif distance <= 185 then
        return 2.0
    elseif distance <= 230 then
        return 3.0
    else
        return VeilConfig.HeadOffset
    end
end

-- ============================================
-- 🎯 VEIL GET DYNAMIC PREDICTION
-- ============================================
local function VeilGetDynamicPrediction()
    if not VeilConfig.Enabled then return nil end
    
    local closestTarget, _, shortestDistance = VeilScanSingleTarget()

    if closestTarget and closestTarget.Parent and closestTarget:IsA("BasePart") then
        if VeilConfig.AutoPredictHeight then
            VeilState.CurrentHeightOffset = VeilGetAutoHeight(shortestDistance)
        else
            VeilState.CurrentHeightOffset = VeilConfig.HeadOffset
        end
        
        local currentPos = closestTarget.Position + Vector3.new(0, VeilState.CurrentHeightOffset, 0)
        local velocity = closestTarget.AssemblyLinearVelocity or Vector3.new(0, 0, 0)
        local targetId = closestTarget.Parent.Name
        
        local acceleration = Vector3.new(0, 0, 0)
        if VeilState.LastPositions[targetId] then
            local lastData = VeilState.LastPositions[targetId]
            local timeDiff = os.clock() - lastData.Time
            if timeDiff > 0 then
                local currentVelocity = (currentPos - lastData.Pos) / timeDiff
                acceleration = (currentVelocity - lastData.Velocity) / timeDiff
            end
        end
        
        VeilState.LastPositions[targetId] = {
            Pos = currentPos,
            Velocity = velocity,
            Time = os.clock()
        }

        local ping = LocalPlayer:GetNetworkPing() or 0.05
        local travelTime = shortestDistance / VeilConfig.ProjectileSpeed
        local totalTime = travelTime + ping
        
        local futureX = currentPos.X + (velocity.X * totalTime) + (0.5 * acceleration.X * (totalTime ^ 2))
        local futureZ = currentPos.Z + (velocity.Z * totalTime) + (0.5 * acceleration.Z * (totalTime ^ 2))
        
        local baseHeight = currentPos.Y + (velocity.Y * totalTime)
        local heightDiff = math.abs(currentPos.Y - LocalPlayer.Character.HumanoidRootPart.Position.Y)
        local gravityDrop = 0.5 * workspace.Gravity * (travelTime ^ 2)
        local studsDropCompensation = VeilConfig.GravityCompensation * gravityDrop
        
        if heightDiff < 1.5 then
            studsDropCompensation = studsDropCompensation * 0.7
        end
        
        if shortestDistance > 300 then
            local extraLongRangeBoost = (shortestDistance / 100) * 0.6
            studsDropCompensation = studsDropCompensation + extraLongRangeBoost
        end
        
        local finalPredictedPos = Vector3.new(futureX, baseHeight + studsDropCompensation, futureZ)
        
        VeilState.LastDistance = shortestDistance
        
        return finalPredictedPos
    end
    
    return nil
end

