            task.wait(0.02)
            VirtualInputManager:SendMouseButtonEvent(cx, cy, 0, false, Enum.UserInputType.MouseButton1, 0)
            success = true
        end)
    end
    
    return success
end

local function PressESC()
    local success = false
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Escape, false, nil)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Escape, false, nil)
        success = true
    end)
    if not success then return false end
    task.wait(ParryConfig.ESCBetweenDelay)
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Escape, false, nil)
        task.wait(0.05)
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Escape, false, nil)
        success = true
    end)
    return success
end

local function DetectKiller(killerChar)
    if not killerChar then return nil, nil end
    local humanoid = killerChar:FindFirstChildOfClass("Humanoid")
    if not humanoid then return nil, nil end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return nil, nil end
    for _, track in pairs(animator:GetPlayingAnimationTracks()) do
        local animId = track.Animation.AnimationId
        if animId then
            local id = animId:match("%d+")
            if id and KillerDatabase[id] then
                return KillerDatabase[id], id
            end
        end
    end
    return nil, nil
end

local function IsKillerAttacking(killerChar)
    if not killerChar then return false end
    local humanoid = killerChar:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return false end
    for _, track in pairs(animator:GetPlayingAnimationTracks()) do
        local animId = track.Animation.AnimationId
        if animId then
            local id = animId:match("%d+")
            if id and KillerDatabase[id] then
                return true
            end
        end
    end
    return false
end

local function IsKillerFacingPlayer(killerChar)
    if not killerChar then return false end
    local killerRoot = killerChar:FindFirstChild("HumanoidRootPart")
    local playerRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not killerRoot or not playerRoot then return false end
    local direction = (playerRoot.Position - killerRoot.Position).Unit
    local lookVector = killerRoot.CFrame.LookVector
    return lookVector:Dot(direction) > 0.5
end

local function GetNearestKiller()
    local char = LocalPlayer.Character
    if not char then return nil, math.huge end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, math.huge end
    local nearest, nearestDist = nil, math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local team = player.Team and player.Team.Name or ""
            if team == "Killer" then
                local kChar = player.Character
                if kChar then
                    local kRoot = kChar:FindFirstChild("HumanoidRootPart")
                    if kRoot then
                        local dist = (kRoot.Position - root.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearest = kChar
                        end
                    end
                end
            end
        end
    end
    return nearest, nearestDist
end

local function IsKillerVisible(killerChar)
    if not killerChar then return false end
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    local killerRoot = killerChar:FindFirstChild("HumanoidRootPart")
    if not root or not killerRoot then return false end
    local origin = root.Position
    local direction = (killerRoot.Position - origin).Unit
    local distance = (killerRoot.Position - origin).Magnitude
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = { char, killerChar, LocalPlayer, workspace.CurrentCamera }
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            table.insert(raycastParams.FilterDescendantsInstances, player.Character)
        end
    end
    local result = workspace:Raycast(origin, direction * distance, raycastParams)
    if result then
        local hit = result.Instance
        if hit then
            local current = hit
            while current do
                if current.Name == "Map" or current:IsDescendantOf(workspace:FindFirstChild("Map")) then
                    return false
                end
                current = current.Parent
            end
        end
    end
    return true
end

