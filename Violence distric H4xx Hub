-- ============ WALLCHECK ============
local function IsKillerVisible(killerChar)
    if not killerChar then return false end
    
    local char = LocalPlayer.Character
    if not char then return false end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    local killerRoot = killerChar:FindFirstChild("HumanoidRootPart")
    
    if not root or not killerRoot then return false end
    
    local origin = root.Position
    local direction = (killerRoot.Position - origin).Unit
    local distance = (killerRoot.Position - origin).Magnitude
    
    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Blacklist
    raycastParams.FilterDescendantsInstances = {
        char,
        killerChar,
        LocalPlayer,
        workspace.CurrentCamera,
    }
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            table.insert(raycastParams.FilterDescendantsInstances, player.Character)
        end
    end
    
    local result = workspace:Raycast(origin, direction * distance, raycastParams)
    
    if result then
        local hit = result.Instance
        if hit then
            local isMap = false
            local current = hit
            while current do
                if current.Name == "Map" or current:IsDescendantOf(workspace:FindFirstChild("Map")) then
                    isMap = true
                    break
                end
                current = current.Parent
            end
            
            if isMap then
                return false
            end
        end
    end
    
    return true
end

