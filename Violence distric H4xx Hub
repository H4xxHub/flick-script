local function IsInSuccessZone()
    local components = GetSkillCheckComponents()
    if not components then return false end
    if not components.Line or not components.Goal then return false end
    
    local line = components.Line
    local goal = components.Goal
    
    local currentRotation = line.Rotation % 360
    local goalRotation = goal.Rotation % 360
    
    local successStart = (100 + goalRotation) % 360
    local successEnd = (118 + goalRotation) % 360
    
    local inZone = false
    if successStart <= successEnd then
        if currentRotation >= successStart and currentRotation <= successEnd then
            inZone = true
        end
    else
        if currentRotation >= successStart or currentRotation <= successEnd then
            inZone = true
        end
    end
    
    local visualInZone = false
    pcall(function()
        local linePos = line.Position
        local goalPos = goal.Position
        local distance = (linePos - goalPos).Magnitude
        if distance < 50 then
            visualInZone = true
        end
    end)
    
    local sizeInZone = false
    pcall(function()
        local successZone = components.SuccessZone
        if successZone then
            local linePos = line.Position
            local zonePos = successZone.Position
            local zoneSize = successZone.Size
            local halfWidth = zoneSize.X / 2
            local distance = math.abs(linePos.X - zonePos.X)
            if distance < halfWidth then
                sizeInZone = true
            end
        end
    end)
    
    return inZone or visualInZone or sizeInZone
end

