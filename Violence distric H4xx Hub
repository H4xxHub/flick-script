-- ============ FUNGSI CEK KILLER STUN ============
local function CheckKillerStun()
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local team = player.Team and player.Team.Name or ""
            if team == "Killer" then
                local char = player.Character
                if char then
                    local humanoid = char:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        local speed = humanoid.WalkSpeed
                        if speed == 0 and not KillerStunNotified then
                            KillerStunNotified = true
                            WindUI:Notify({
                                Title = "KILLER STUNNED!",
                                Content = player.Name .. " is stunned! Speed: 0",
                                Duration = 3,
                            })
                            print("[Killer Stun] " .. player.Name .. " is stunned!")
                            return true
                        elseif speed > 0 then
                            KillerStunNotified = false
                        end
                    end
                end
            end
        end
    end
    return false
end

