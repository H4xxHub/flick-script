local function GetSilentTarget()
    local target = nil
    local targetDist = math.huge
    
    local char = LocalPlayer.Character
    if not char then return nil, math.huge end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, math.huge end
    
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local team = player.Team and player.Team.Name or ""
            if team == SilentAimConfig.TargetTeam then
                local kChar = player.Character
                if kChar then
                    local kRoot = kChar:FindFirstChild("HumanoidRootPart")
                    if kRoot then
                        local dist = (kRoot.Position - root.Position).Magnitude
                        if dist < targetDist then
                            targetDist = dist
                            target = kChar
                        end
                    end
                end
            end
        end
    end
    
    return target, targetDist
end

-- GET TARGET POSITION - BODY
local function GetTargetPositionBody(target)
    if not target then return nil, math.huge end
    
    local targetRoot = target:FindFirstChild("HumanoidRootPart")
    if not targetRoot then return nil, math.huge end
    
    local char = LocalPlayer.Character
    if not char then return nil, math.huge end
    
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, math.huge end
    
    local killerPos = targetRoot.Position
    
    -- Velocity prediction
    local velocity = Vector3.new(0, 0, 0)
    if SilentAimState.LastPosition then
        local deltaTime = tick() - SilentAimState.LastTime
        if deltaTime > 0 and deltaTime < 0.5 then
            velocity = (killerPos - SilentAimState.LastPosition) / deltaTime
            if velocity.Magnitude > 50 then
                velocity = velocity.Unit * 50
            end
        end
    end
    
    SilentAimState.LastPosition = killerPos
    SilentAimState.LastTime = tick()
    SilentAimState.TargetVelocity = velocity
    
    local distance = (killerPos - root.Position).Magnitude
    local timeToTarget = distance / SilentAimConfig.BulletSpeed
    
    -- Prediction
    local prediction = Vector3.new(0, 0, 0)
    if velocity.Magnitude > 1.0 then
        prediction = velocity * timeToTarget * 0.8
    end
    
    -- Target ke BODY
    local targetPos = killerPos + prediction
    
    return targetPos, distance
end

