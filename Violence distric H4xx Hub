local function CreateOutline(instance, color)
    if not instance then return nil end
    
    local existing = instance:FindFirstChild("H4XX_Highlight")
    if existing then existing:Destroy() end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "H4XX_Highlight"
    highlight.FillColor = color
    highlight.OutlineColor = color
    highlight.FillTransparency = 0.8  -- 🔥 20% FILL
    highlight.OutlineTransparency = 0.1
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Adornee = instance
    highlight.Parent = instance
    return highlight
end

local function GetPlayerColor(player)
    if not player then return Color3.fromRGB(255, 255, 255) end
    local team = player.Team and player.Team.Name or ""
    if team == "Killer" then
        return Color3.fromRGB(255, 0, 0)
    elseif team == "Survivors" then
        local char = player.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                local healthPercent = (humanoid.Health / humanoid.MaxHealth) * 100
                if healthPercent >= 80 then return Color3.fromRGB(0, 255, 0)
                elseif healthPercent >= 50 then return Color3.fromRGB(255, 255, 0)
                elseif healthPercent >= 20 then return Color3.fromRGB(255, 165, 0)
                else return Color3.fromRGB(255, 0, 0)
                end
            end
        end
        return Color3.fromRGB(0, 255, 0)
    else
        return Color3.fromRGB(255, 255, 255)
    end
end

