local function TriggerParry()
    if ParryState.IsParrying or ParryState.IsParryingNow then return false end
    if tick() - ParryState.LastParryTime < ParryConfig.ParryCooldown then return false end
    
    ParryState.IsParryingNow = true
    local success = ClickParryButton()
    
    if success then
        ParryState.LastParryTime = tick()
        ParryState.LastSuccessfulParry = tick()
        ParryState.IsParrying = true
        
        if ParryConfig.AutoESC then
            task.spawn(function()
                task.wait(ParryConfig.ESCDelay)
                PressESC()
            end)
        end
        
        task.spawn(function()
            task.wait(0.5)
            ParryState.IsParrying = false
            ParryState.IsParryingNow = false
        end)
        return true
    else
        ParryState.IsParryingNow = false
        return false
    end
end

local function AutoParryLoop()
    if not ParryConfig.Enabled then
        SetParryCircleColor(Color3.fromRGB(100, 100, 100))
        UpdateParryStatus("Disabled", Color3.fromRGB(150, 150, 150))
        UpdateParryKiller(nil)
        return
    end
    
    UpdateParryMode(ParryConfig.ParryMode)
    
    local timeSinceGlobal = tick() - ParryState.LastSuccessfulParry
    if timeSinceGlobal < ParryConfig.GlobalCooldown then
        local remaining = ParryConfig.GlobalCooldown - timeSinceGlobal
        SetParryCircleColor(Color3.fromRGB(255, 165, 0))
        UpdateParryStatus(string.format("Global CD: %.0fs", remaining), Color3.fromRGB(255, 165, 0))
        UpdateParryGlobalCD(remaining)
        return
    end
    UpdateParryGlobalCD(0)
    
    if tick() - ParryState.LastParryTime < ParryConfig.ParryCooldown then
        local remaining = ParryConfig.ParryCooldown - (tick() - ParryState.LastParryTime)
        UpdateParryCooldown(remaining)
        return
    end
    UpdateParryCooldown(0)
    
    if ParryState.IsParrying or ParryState.IsParryingNow then return end
    
    local killer, distance = GetNearestKiller()
    
    if not killer then
        SetParryCircleColor(Color3.fromRGB(255, 0, 0))
        UpdateParryStatus("No Killer", Color3.fromRGB(255, 100, 100))
        UpdateParryKiller(nil)
        return
    end
    
    local killerData, animId = DetectKiller(killer)
    if killerData then
        UpdateParryKiller(killerData)
    else
        UpdateParryKiller(nil)
    end
    
    local triggerRange = 8
    local delay = 0
    if killerData and killerData.Settings then
        triggerRange = killerData.Settings.TriggerRange or 8
        delay = killerData.Settings.Delay or 0
    end
    
    if distance > triggerRange then
        SetParryCircleColor(Color3.fromRGB(255, 0, 0))
        UpdateParryStatus(string.format("Out of Range (%.1f/%d)", distance, triggerRange), Color3.fromRGB(255, 150, 0))
        return
    end
    
    if ParryConfig.WallCheck then
        local visible = IsKillerVisible(killer)
        if not visible then
            SetParryCircleColor(Color3.fromRGB(255, 0, 0))
            UpdateParryStatus("Wall Blocked", Color3.fromRGB(255, 150, 0))
            return
        end
    end
    
    if not IsKillerFacingPlayer(killer) then
        SetParryCircleColor(Color3.fromRGB(255, 200, 0))
        UpdateParryStatus("Not Facing", Color3.fromRGB(255, 200, 0))
        return
    end
    
    SetParryCircleColor(Color3.fromRGB(0, 255, 0))
    
    local isAttacking = IsKillerAttacking(killer)
    
    if isAttacking then
        local killerName = killerData and killerData.Name or "Unknown"
        
        if ParryState.LastParriedKiller == killerName and 
           tick() - ParryState.LastParriedTime < ParryConfig.PerKillerCooldown then
            local remaining = ParryConfig.PerKillerCooldown - (tick() - ParryState.LastParriedTime)
            SetParryCircleColor(Color3.fromRGB(255, 165, 0))
            UpdateParryStatus(string.format("Killer CD: %.1fs", remaining), Color3.fromRGB(255, 165, 0))
            return
        end
        
        local currentAttackId = animId or "unknown"
        if ParryState.LastAttackId == currentAttackId and 
           tick() - ParryState.LastAttackTime < ParryConfig.AttackCooldown then
            return
        end
        ParryState.LastAttackId = currentAttackId
        ParryState.LastAttackTime = tick()
        
        SetParryCircleColor(Color3.fromRGB(255, 255, 0))
        if killerData then
            local statusText = killerData.Emoji .. " " .. killerData.Name
            if killerData.Settings.IsLunge then
                statusText = statusText .. " [Lunge]"
            else
                statusText = statusText .. " [Melee]"
            end
            if delay > 0 then
                statusText = statusText .. " (Delay " .. delay .. "s)"
            end
            UpdateParryStatus(statusText .. " Attacking!", Color3.fromRGB(255, 255, 0))
        else
            UpdateParryStatus("Attack Detected!", Color3.fromRGB(255, 255, 0))
        end
        
        if delay > 0 then
            task.wait(delay)
        end
        
        local success = TriggerParry()
        
        if success then
            ParryState.LastSuccessfulParry = tick()
            ParryState.LastParriedKiller = killerName
            ParryState.LastParriedTime = tick()
            
            SetParryCircleColor(Color3.fromRGB(0, 255, 255))
            UpdateParryStatus("✅ Parried!", Color3.fromRGB(0, 255, 255))
        else
            SetParryCircleColor(Color3.fromRGB(255, 0, 0))
            UpdateParryStatus("❌ Failed!", Color3.fromRGB(255, 0, 0))
        end
    else
        if killerData then
            local statusText = killerData.Emoji .. " " .. killerData.Name
            if killerData.Settings.IsLunge then
                statusText = statusText .. " [Lunge]"
            else
                statusText = statusText .. " [Melee]"
            end
            UpdateParryStatus(string.format("%s | %.1f/%d studs", statusText, distance, triggerRange), Color3.fromRGB(0, 255, 0))
        else
            UpdateParryStatus(string.format("In Range (%.1f) - Ready", distance), Color3.fromRGB(0, 255, 0))
        end
    end
end

