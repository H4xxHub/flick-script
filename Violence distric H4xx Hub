end

-- Create Line Tracer dari Right Arm ke Body Killer
local function CreateLineTracer(from, to)
    if not from or not to then return nil end
    
    local distance = (to - from).Magnitude
    if distance < 1 then return nil end
    
    local part = Instance.new("Part")
    part.Name = "LineTracer"
    part.Anchored = true
    part.CanCollide = false
    part.Material = Enum.Material.Neon
    part.Color = Color3.fromRGB(255, 0, 0)
    part.Size = Vector3.new(0.1, 0.1, distance)
    part.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -distance / 2)
    part.Parent = workspace
    
    local att = Instance.new("Attachment")
    att.Position = Vector3.new(0, 0, 0)
    att.Parent = part
    
    local beam = Instance.new("Beam")
    beam.Attachment0 = att
    beam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
    beam.Transparency = NumberSequence.new(0.2)
    beam.Width0 = 0.3
    beam.Width1 = 0.3
    beam.FaceCamera = true
    beam.Parent = part
    
    return {part = part, beam = beam, att = att}
end

