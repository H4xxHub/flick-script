end

local function ESPLoop()
    if not ESPLoopRunning then return end
    
    ESPUpdateTimer = ESPUpdateTimer + task.wait()
    if ESPUpdateTimer >= ESPConfig.UpdateInterval or ESPNeedsUpdate then
        ESPUpdateTimer = 0
        ESPNeedsUpdate = false
        task.spawn(function()
            UpdateESP()
        end)
    end
end

