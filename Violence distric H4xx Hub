local function UpdateVeilFOVSize()
    if VeilState.FOVCircle then
        local size = VeilConfig.FOVRadius * 2
        VeilState.FOVCircle.Size = UDim2.new(0, size, 0, size)
        VeilState.FOVCircle.Position = UDim2.new(0.5, -size/2, 0.5, -size/2)
    end
end

local function UpdateLineTracer(screenPos)
    if not VeilState.LineTracer then return end
    if not screenPos then
        VeilState.LineTracer.Visible = false
        return
    end
    
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    local startPos = screenCenter
    local endPos = Vector2.new(screenPos.X, screenPos.Y)
    
    local distance = (endPos - startPos).Magnitude
    local angle = math.atan2(endPos.Y - startPos.Y, endPos.X - startPos.X)
    
    local line = VeilState.LineTracer
    line.Size = UDim2.new(0, distance, 0, 2)
    line.Position = UDim2.new(0, startPos.X, 0, startPos.Y)
    line.Rotation = math.deg(angle)
    line.Visible = true
end

-- ============================================
-- 🔄 VEIL MAIN LOOP
-- ============================================
local VeilLoopConnection = nil

local function VeilMainLoop()
    if not VeilConfig.Enabled then
        if VeilState.FOVCircle then VeilState.FOVCircle.Visible = false end
        if VeilState.LineTracer then VeilState.LineTracer.Visible = false end
        VeilState.LockedTarget = nil
        VeilState.LockedTargetScreenPos = nil
        return
    end
    
    if not VeilState.ScreenGui then
        CreateVeilVisuals()
    end
    
    if VeilState.FOVCircle then
        VeilState.FOVCircle.Visible = true
    end
    
    local targetPart, screenPos2D, _ = VeilScanSingleTarget()
    
    if targetPart and screenPos2D then
        VeilState.LockedTarget = targetPart
        VeilState.LockedTargetScreenPos = screenPos2D
        UpdateLineTracer(screenPos2D)
    else
        VeilState.LockedTarget = nil
        VeilState.LockedTargetScreenPos = nil
        if VeilState.LineTracer then
            VeilState.LineTracer.Visible = false
        end
    end
end

