local function GetSilentTarget()
    local char = LocalPlayer.Character
    if not char then return nil, math.huge end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil, math.huge end
    local bestTarget, bestDist = nil, math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local team = player.Team and player.Team.Name or ""
            if team == SilentAimConfig.TargetTeam then
                local pChar = player.Character
                if pChar then
                    local pRoot = pChar:FindFirstChild("HumanoidRootPart")
                    if pRoot then
                        local dist = (pRoot.Position - root.Position).Magnitude
                        if dist < bestDist then
                            bestDist = dist
                            bestTarget = pChar
                        end
                    end
                end
            end
        end
    end
    return bestTarget, bestDist
end

local function GetSilentTargetPosition(target)
    if not target then return nil end
    local targetPart = target:FindFirstChild("HumanoidRootPart")
    if not targetPart then return nil end
    local targetPos = targetPart.Position + Vector3.new(
        SilentAimConfig.OffsetX,
        SilentAimConfig.OffsetY,
        SilentAimConfig.OffsetZ
    )
    local velocity = Vector3.new(0, 0, 0)
    if SilentAimState.LastPosition then
        local dt = tick() - SilentAimState.LastTime
        if dt > 0 and dt < 0.5 then
            velocity = (targetPos - SilentAimState.LastPosition) / dt
            if velocity.Magnitude > 50 then
                velocity = velocity.Unit * 50
            end
        end
    end
    SilentAimState.LastPosition = targetPos
    SilentAimState.LastTime = tick()
    SilentAimState.TargetVelocity = velocity
    if SilentAimConfig.AutoPredict and velocity.Magnitude > SilentAimConfig.MinVelocity then
        local char = LocalPlayer.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                local distance = (targetPos - root.Position).Magnitude
                local timeToTarget = distance / SilentAimConfig.BulletSpeed
                local prediction = velocity * timeToTarget * SilentAimConfig.PredictionMultiplier
                if prediction.Magnitude < SilentAimConfig.MaxPrediction then
                    targetPos = targetPos + prediction
                end
            end
        end
    end
    return targetPos
end

local function GetSilentMuzzlePosition()
    local char = LocalPlayer.Character
    if not char then return nil end
    local twist = char:FindFirstChild("Twist of Fate")
    if not twist then return nil end
    for _, child in pairs(twist:GetChildren()) do
        if child:IsA("BasePart") and (child.Name == "Muzzle" or child.Name == "Handle") then
            return child.Position
        end
    end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        return root.Position + Vector3.new(0, 2, 0)
    end
    return nil
end

local function CalculateManipulatedDirection(targetPos, muzzlePos)
    if not targetPos or not muzzlePos then return nil end
    local rawDirection = (targetPos - muzzlePos).Unit
    local manipulatedDirection = rawDirection
    if SilentAimState.Direction.Magnitude > 0 then
        local smoothness = SilentAimConfig.Smoothness
        manipulatedDirection = SilentAimState.Direction:Lerp(rawDirection, 1 - smoothness)
        manipulatedDirection = manipulatedDirection.Unit
    end
    SilentAimState.Direction = manipulatedDirection
    return manipulatedDirection
end

local function HookFireRemote()
    local fireRemote = GetFireRemote()
    if not fireRemote then
        print("[SilentAim] ❌ Fire remote not found!")
        return false
    end
    
    print("[SilentAim] 🔥 Fire remote hooked!")
    
    local oldFire = fireRemote.FireServer
    fireRemote.FireServer = function(self, ...)
        local args = {...}
        
        if not SilentAimConfig.Enabled then
            return oldFire(self, unpack(args))
        end
        
        local gunTool = args[1]
        if not gunTool or gunTool.Name ~= "Twist of Fate" then
            return oldFire(self, unpack(args))
        end
        
        if tick() - SilentAimState.LastFireTime < SilentAimConfig.FireCooldown then
            return oldFire(self, unpack(args))
        end
        
        local target, dist = GetSilentTarget()
        if not target then
            return oldFire(self, unpack(args))
        end
        
        local targetPos = GetSilentTargetPosition(target)
        if not targetPos then
            return oldFire(self, unpack(args))
        end
        
        local muzzlePos = GetSilentMuzzlePosition()
        if not muzzlePos then
            return oldFire(self, unpack(args))
        end
        
        local manipulatedDirection = CalculateManipulatedDirection(targetPos, muzzlePos)
        if not manipulatedDirection then
            return oldFire(self, unpack(args))
        end
        
        args[2] = manipulatedDirection
        
        SilentAimState.Target = target
        SilentAimState.TargetPosition = targetPos
        SilentAimState.IsFiring = true
        SilentAimState.LastFireTime = tick()
        
        local success, err = pcall(function()
            return oldFire(self, unpack(args))
        end)
        
        SilentAimState.IsFiring = false
        
        if not success then
            return oldFire(self, unpack(args))
        end
        
        return success
    end
    
    SilentAimState.FireRemote = fireRemote
    return true
end

