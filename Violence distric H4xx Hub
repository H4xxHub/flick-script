local ParryAnimation = nil
local function LoadParryAnimation()
    local char = LocalPlayer.Character
    if not char then return end
    
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end
    
    local animator = humanoid:FindFirstChildOfClass("Animator")
    if not animator then return end
    
    local anim = Instance.new("Animation")
    anim.AnimationId = "rbxassetid://126395940927900"
    
    ParryAnimation = animator:LoadAnimation(anim)
    ParryAnimation.Priority = Enum.AnimationPriority.Core
end

local function PlayParryAnimation()
    if ParryAnimation then
        ParryAnimation:Play()
    else
        LoadParryAnimation()
        if ParryAnimation then
            ParryAnimation:Play()
        end
    end
end

local function StopParryAnimation()
    if ParryAnimation then
        ParryAnimation:Stop()
    end
end

