-- ============ PARRYING DAGGER REMOTE (DOUBLE PARRY) ============
local function ParryWithDaggerRemote()
    local remote = game:GetService("ReplicatedStorage"):WaitForChild("Remotes"):WaitForChild("Items"):WaitForChild("Parrying Dagger"):WaitForChild("parry")
    
    if ParryConfig.DoubleParry then
        local success1, err1 = pcall(function()
            remote:FireServer()
        end)
        
        task.wait(ParryConfig.ParryDelay)
        
        local success2, err2 = pcall(function()
            remote:FireServer()
        end)
        
        if success1 and success2 then
            print("[Parry Dagger] ✅ Double parry (0.005s delay) executed!")
            return true
        elseif success1 then
            print("[Parry Dagger] ⚠️ Only first parry succeeded!")
            return true
        elseif success2 then
            print("[Parry Dagger] ⚠️ Only second parry succeeded!")
            return true
        else
            print("[Parry Dagger] ❌ Double parry failed:", err1, err2)
            return false
        end
    else
        local success, err = pcall(function()
            remote:FireServer()
        end)
        
        if success then
            print("[Parry Dagger] ✅ Parry executed!")
            return true
        else
            print("[Parry Dagger] ❌ Parry failed:", err)
            return false
        end
    end
end

-- ============ TRIGGER PARRY ============
local function TriggerParry()
    local success = ParryWithDaggerRemote()
    
    if success then
        ParryState.LastParryTime = tick()
        ParryState.IsParrying = true
        
        -- FREEZE PLAYER SAAT PARRY BERHASIL
        if ParryConfig.FreezeOnParry then
            local player = game.Players.LocalPlayer
            local char = player.Character
            if char then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    hum.WalkSpeed = 0
                    print("[Parry] Speed 0 selama", ParryConfig.FreezeDuration, "detik")
                    
                    task.spawn(function()
                        task.wait(ParryConfig.FreezeDuration)
                        hum.WalkSpeed = 16
                        print("[Parry] Speed kembali ke 16")
                    end)
                end
            end
        end
        
        task.spawn(function()
            task.wait(0.5)
            ParryState.IsParrying = false
        end)
        
        return true
    end
    
    return false
end

