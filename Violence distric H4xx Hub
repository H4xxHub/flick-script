end

-- FIRE TO KILLER (FIXED)
local function FireToKiller()
    if not SilentAimConfig.Enabled then return false end
    if SilentAimState.IsFiring then return false end
    
    SilentAimState.IsFiring = true
    
    -- AMBIL GUN TOOL
    local gunTool = GetGunTool()
    if not gunTool then
        SilentAimState.IsFiring = false
        return false
    end
    
    -- AMBIL TARGET
    local target, rawDist = GetSilentTarget()
    if not target then
        SilentAimState.IsFiring = false
        return false
    end
    
    -- AMBIL POSISI TARGET
    local targetPos, distance = GetTargetPositionBody(target)
    if not targetPos then
        SilentAimState.IsFiring = false
        return false
    end
    
    -- AMBIL POSISI MUZZLE
    local myPos = GetMuzzlePosition()
    if not myPos then
        SilentAimState.IsFiring = false
        return false
    end
    
    -- HITUNG ARAH
    local direction = (targetPos - myPos).Unit
    
    -- AMBIL REMOTE
    local remote = ReplicatedStorage:FindFirstChild("Remotes")
    if not remote then
        SilentAimState.IsFiring = false
        return false
    end
    
    local twistRemote = remote:FindFirstChild("Items"):FindFirstChild("Twist of Fate")
    if not twistRemote then
        SilentAimState.IsFiring = false
        return false
    end
    
    local fireRemote = twistRemote:FindFirstChild("Fire")
    if not fireRemote then
        SilentAimState.IsFiring = false
        return false
    end
    
    -- FIRESERVER
    local success, err = pcall(function()
        fireRemote:FireServer(gunTool, direction)
    end)
    
    SilentAimState.IsFiring = false
    
    if success then
        CheckKillerStun()
        return true
    end
    
    return false
end

-- SILENT AIM LOOP
local function SilentAimLoop()
    if not SilentAimConfig.Enabled then return end
    
    local target, _ = GetSilentTarget()
    if target then
        local targetRoot = target:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            local current = targetRoot.Position
            if SilentAimState.LastPosition then
                local dt = tick() - SilentAimState.LastTime
                if dt > 0 and dt < 0.5 then
                    SilentAimState.TargetVelocity = (current - SilentAimState.LastPosition) / dt
                end
            end
            SilentAimState.LastPosition = current
            SilentAimState.LastTime = tick()
        end
    end
    
    local isAiming = IsAimAnimationPlaying()
    
    SilentAimState.WasAiming = SilentAimState.IsAiming
    SilentAimState.IsAiming = isAiming
    
    if SilentAimState.WasAiming and not SilentAimState.IsAiming then
        FireToKiller()
    end
end

